{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    "security:minimumReleaseAgePypi"
  ],
  "timezone": "Etc/UTC",
  "schedule": ["* 0-3 * * 1"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 * * 1"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["torch", "torchvision", "torchaudio"],
      "groupName": "pytorch"
    }
  ]
}
